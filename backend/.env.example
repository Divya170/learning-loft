# Copy to .env and adjust.
PORT=4000
# Comma-separated list of allowed browser origins (the Next.js site).
CORS_ORIGIN=http://localhost:3000
# SQLite file. schema.sql and seed.sql are read from the same folder.
DATABASE_PATH=../database/app.sqlite
# Secret used by the admin dashboard (sent as a Bearer token). Change this!
ADMIN_TOKEN=change-me-learning-loft
# Salt used to hash visitor IPs for rate limiting (raw IPs are never stored).
IP_HASH_SALT=change-me-too
